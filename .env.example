# ============================================================
# LDC Insumos — Plataforma Comercial (CPQ Inteligente)
# Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env — ele está no .gitignore.
# ============================================================

# --- Banco de dados ---
# SQL Server / Microsoft Fabric
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ldc-cpq
DB_USER=sa
DB_PASSWORD=SuaSenhaAqui

# true = usa SQLite local (sqlite:///./dev.db) em vez de SQL Server
USE_SQLITE=true

# Se definido, sobrescreve os campos de conexão acima
DATABASE_URL=

# --- Segurança JWT ---
SECRET_KEY=troque-esta-chave-por-uma-string-aleatoria-de-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8 horas

# --- Aplicação ---
APP_ENV=development       # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:1050

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:1050,http://127.0.0.1:1050

# --- Frontend Dash ---
DASH_HOST=0.0.0.0
DASH_PORT=1050
DASH_DEBUG=true
